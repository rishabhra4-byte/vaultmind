{
  // Terminal → Run Task… (or Ctrl+Shift+B for "Run VaultMind").
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Set up (first time)",
      "detail": "Python virtual environment with the backend's packages, and the web app's packages",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt && cd ../frontend && npm ci",
      "windows": {
        "command": "python -m venv .venv; .venv\\Scripts\\pip install -r requirements-dev.txt; cd ..\\frontend; npm.cmd ci"
      },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend (API on :8000)",
      "type": "shell",
      "command": ".venv/bin/python -m uvicorn app.main:app --reload --port 8000",
      "windows": { "command": ".venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^ERROR:\\s+(.*)$", "message": 1 },
        "background": { "beginsPattern": "Will watch for changes", "endsPattern": "Application startup complete" }
      }
    },
    {
      "label": "Web app (:5173)",
      "type": "shell",
      "command": "npm run dev",
      "windows": { "command": "npm.cmd run dev" },
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^\\s*error\\s+(.*)$", "message": 1 },
        "background": { "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    },
    {
      "label": "Run VaultMind",
      "detail": "Backend and web app together; open http://localhost:5173",
      "dependsOn": ["Backend (API on :8000)", "Web app (:5173)"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Backend tests",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -q",
      "windows": { "command": ".venv\\Scripts\\python -m pytest -q" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Answer-quality benchmark",
      "type": "shell",
      "command": ".venv/bin/python -m eval.run --check",
      "windows": { "command": ".venv\\Scripts\\python -m eval.run --check" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Type-check the web app",
      "type": "shell",
      "command": "npx tsc -b",
      "windows": { "command": "npx.cmd tsc -b" },
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": "$tsc"
    }
  ]
}
