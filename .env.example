# Copy to the project root as .env (Docker Compose) or to backend/.env (local runs).

# Required in production: a random value of at least 32 characters. Generate one with
#   echo "VAULTMIND_JWT_SECRET=$(openssl rand -hex 32)" >> .env
# (In development, a random secret is generated if this is missing; sign-ins reset on restart.)
# VAULTMIND_JWT_SECRET=

# Demo mode: seeds a fictional company with nine accounts that share the password demo1234,
# including an administrator. On by default in development, off by default in production
# (the Docker image). Set it to true only for a public demo, never alongside real documents.
# VAULTMIND_SEED_DEMO_DATA=true

# Optional. Without a key the assistant answers in offline mode (same access control,
# answers built from matching passages and labelled as such).
VAULTMIND_ANTHROPIC_API_KEY=

# Set to true once the app is served over HTTPS.
# VAULTMIND_HSTS=false

# Behind a reverse proxy: the proxy's address, so sign-in limits see real client addresses.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Other settings and their defaults
# VAULTMIND_ENV=development            (the Docker image sets production)
# VAULTMIND_LLM_MODEL=claude-sonnet-5-5
# VAULTMIND_LLM_TIMEOUT_SECONDS=30
# VAULTMIND_LLM_MAX_RETRIES=2
# VAULTMIND_MAX_UPLOAD_MB=20
# VAULTMIND_DATABASE_URL=sqlite:///./vaultmind.db
# POSTGRES_PASSWORD=vaultmind          (Docker Compose only; set your own for a real install)
