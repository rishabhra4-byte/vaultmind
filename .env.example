# Copy to backend/.env (local) or the project root (Docker Compose) and fill in.

# Optional. Without it the assistant runs in offline mode (same access control,
# answers built from matching passages instead of written by Claude).
VAULTMIND_ANTHROPIC_API_KEY=

# Required in any real deployment: a long random string, e.g. `openssl rand -hex 32`
VAULTMIND_JWT_SECRET=

# Defaults shown
# VAULTMIND_LLM_MODEL=claude-sonnet-5-5
# VAULTMIND_DATABASE_URL=sqlite:///./vaultmind.db
# VAULTMIND_SEED_DEMO_DATA=true
