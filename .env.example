# Copy to the project root as .env (Docker Compose) or to backend/.env (local runs).

# Required in production: a random value of at least 32 characters. Generate one with
#   echo "VAULTMIND_JWT_SECRET=$(openssl rand -hex 32)" >> .env
# (In development, a random secret is generated if this is missing; sign-ins reset on restart.)
# VAULTMIND_JWT_SECRET=

# Demo mode: seeds a fictional company with nine accounts that share the password demo1234,
# including an administrator. On by default in development, off by default in production
# (the Docker image). Set it to true only for a public demo, never alongside real documents.
# VAULTMIND_SEED_DEMO_DATA=true

# Optional. Without a key the assistant answers in offline mode (same access control,
# answers built from matching passages and labelled as such).
VAULTMIND_ANTHROPIC_API_KEY=

# Set to true once the app is served over HTTPS.
# VAULTMIND_HSTS=false

# Behind a reverse proxy: the proxy's address, so sign-in limits see real client addresses.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# The address people use to reach VaultMind. Needed for "Sign in with Google/Microsoft" and
# for links in emails and Slack messages.
# VAULTMIND_PUBLIC_URL=https://vaultmind.example.com

# ---- Running it safely (see docs/operations.md and docs/ai-data-policy.md) ----

# Limits on AI use per day (UTC), so the bill stays predictable; 0 means no limit. Past a
# limit, answers are built offline and say why. Counts every AI call company-wide, and
# AI-written answers per person.
# VAULTMIND_AI_DAILY_LIMIT=0
# VAULTMIND_AI_DAILY_LIMIT_PER_PERSON=0

# The highest classification whose text may be sent to the AI service. The default keeps
# restricted documents local; "internal" keeps confidential ones local too.
# VAULTMIND_AI_MAX_CLASSIFICATION=confidential

# Sign people out after this many minutes without activity (0 turns it off).
# VAULTMIND_SESSION_IDLE_MINUTES=120

# Scheduled backups, each checked by restoring it into a scratch database. Use storage that
# isn't on this machine and is encrypted: backups hold every document and password hash.
# VAULTMIND_BACKUP_DIR=/backups
# VAULTMIND_BACKUP_INTERVAL_HOURS=24
# VAULTMIND_BACKUP_KEEP=14

# Malware scanning with ClamAV ("host:port" or a socket path). While set, files clamd can't
# scan are refused; VAULTMIND_CLAMAV_REQUIRED=false accepts them unscanned instead.
# With Docker Compose: docker compose --profile clamav up -d, and VAULTMIND_CLAMAV_ADDRESS=clamav:3310
# VAULTMIND_CLAMAV_ADDRESS=
# VAULTMIND_CLAMAV_REQUIRED=true

# Prometheus metrics at /metrics, for scrapers sending this as a bearer token (off when unset).
# Generate one with: openssl rand -hex 32. Alert rules: deploy/prometheus-alerts.yml
# VAULTMIND_METRICS_TOKEN=

# ---- Connecting to your company (all optional; see docs/integrations.md) ----

# Shared folders admins may connect (mount them into the container first).
# VAULTMIND_FOLDER_ROOTS=["/shares"]

# Google Workspace: Drive files, people and groups (service account with domain-wide delegation)
# VAULTMIND_GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-sa.json
# VAULTMIND_GOOGLE_ADMIN_EMAIL=it-admin@example.com
# Sign in with Google (an OAuth client) and which domains may sign in
# VAULTMIND_GOOGLE_CLIENT_ID=
# VAULTMIND_GOOGLE_CLIENT_SECRET=
# VAULTMIND_GOOGLE_ALLOWED_DOMAINS=["example.com"]

# Microsoft 365: SharePoint/OneDrive files, people and groups (app registration)
# VAULTMIND_MICROSOFT_TENANT_ID=
# VAULTMIND_MICROSOFT_CLIENT_ID=
# VAULTMIND_MICROSOFT_CLIENT_SECRET=
# VAULTMIND_MICROSOFT_SSO=true        (also show "Continue with Microsoft")

# Company sign-in options
# VAULTMIND_SSO_AUTO_CREATE=true      (give people from allowed domains an account on first sign-in)
# VAULTMIND_SSO_DEFAULT_TEAM=         (their team; default: the first team)
# VAULTMIND_PASSWORD_LOGIN=true       (false: only admins may still use a password)

# Email copies of notifications
# VAULTMIND_SMTP_HOST=smtp.example.com
# VAULTMIND_SMTP_PORT=587
# VAULTMIND_SMTP_USERNAME=
# VAULTMIND_SMTP_PASSWORD=
# VAULTMIND_SMTP_FROM=VaultMind <vaultmind@example.com>

# Slack: /vaultmind, mentions, direct messages, and notification copies
# VAULTMIND_SLACK_BOT_TOKEN=xoxb-...
# VAULTMIND_SLACK_SIGNING_SECRET=

# Other settings and their defaults
# VAULTMIND_ENV=development            (the Docker image sets production)
# VAULTMIND_LLM_MODEL=claude-sonnet-5-5
# VAULTMIND_LLM_TIMEOUT_SECONDS=30
# VAULTMIND_LLM_MAX_RETRIES=2
# VAULTMIND_MAX_UPLOAD_MB=20
# VAULTMIND_DATABASE_URL=sqlite:///./vaultmind.db
# VAULTMIND_SCHEDULER_ENABLED=true     (background syncs, reminders, email/Slack delivery)
# POSTGRES_PASSWORD=vaultmind          (Docker Compose only; set your own for a real install)
